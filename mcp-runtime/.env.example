# Backend origin. Default is loopback http. An https tunnel URL (Manufact hosting) needs the flag below.
STEWARD_BACKEND_URL=http://127.0.0.1:8001
# Permit a NON-loopback https backend origin. Default off: only loopback http is accepted.
# STEWARD_ALLOW_REMOTE_BACKEND=true
# Listener port. When the platform injects PORT (Manufact) the server listens on it and binds 0.0.0.0;
# otherwise 127.0.0.1. STEWARD_MCP_HOST / STEWARD_MCP_PORT override.
STEWARD_MCP_PORT=8002
# Optional CSV subset of the three site IDs.
STEWARD_MCP_PROPERTY_IDS=cedar,harbor,juniper
# Match the backend's configured API token, if enabled there.
# STEWARD_BACKEND_TOKEN=
# Optional separate client token required by this MCP listener. Not the backend token.
# STEWARD_MCP_TOKEN=
# Armature analytics (@armature-tech/mcp-analytics/v2): no key, no analytics. ARMATURE_API_KEY maps to the SDK's key.
# ANALYTICS_INGEST_API_KEY=
# ANALYTICS_INGEST_URL=   # EU workspaces only; US is the default
