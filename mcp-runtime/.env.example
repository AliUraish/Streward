# Backend origin. Default is loopback http. An https tunnel URL (Manufact hosting) needs the flag below.
STEWARD_BACKEND_URL=http://127.0.0.1:8001
# Permit a NON-loopback https backend origin. Default off: only loopback http is accepted.
# STEWARD_ALLOW_REMOTE_BACKEND=true
# Listener port. When the platform injects PORT (Manufact) the server listens on it and binds 0.0.0.0;
# otherwise 127.0.0.1. STEWARD_MCP_HOST / STEWARD_MCP_PORT override.
STEWARD_MCP_PORT=8002
# Optional CSV subset of the three site IDs (harbor-works is retired and ignored).
STEWARD_MCP_PROPERTY_IDS=myer-plant,bristol-pumps,tomioka-mill
# The acting agent (X-Steward-Actor): operator (default), director, or myer-/bristol-/tomioka- manager, engineer, compliance, technician.
# STEWARD_MCP_ACTOR=operator
# wait_for hold window in seconds (1 to 300; default 50, below the 60 s timeout of clients that do not reset on progress).
# STEWARD_WAIT_DEFAULT_SECONDS=50
# Eval harness only, never on a hosted endpoint: honour the X-Steward-Act-As header per request.
# STEWARD_MCP_ALLOW_ACT_AS=true
# Eval harness only, never on a hosted endpoint: list and serve list_scenarios / start_scenario to requests that carry
# X-Steward-Harness: evals (evals/run.mjs sends it). Off, every client sees 71 tools and no scenario machinery.
# STEWARD_MCP_HARNESS_TOOLS=true
# Match the backend's configured API token, if enabled there.
# STEWARD_BACKEND_TOKEN=
# Optional separate client token required by this MCP listener. Not the backend token.
# STEWARD_MCP_TOKEN=
# Armature analytics (@armature-tech/mcp-analytics/v2): no key, no analytics. ARMATURE_API_KEY maps to the SDK's key.
# ANALYTICS_INGEST_API_KEY=
# ANALYTICS_INGEST_URL=   # EU workspaces only; US is the default
