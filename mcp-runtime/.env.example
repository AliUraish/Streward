# Local adapter only. Never set an external/public backend URL.
STEWARD_BACKEND_URL=http://127.0.0.1:8001
STEWARD_MCP_PORT=8002
# Optional CSV subset of the three stable property IDs.
STEWARD_MCP_PROPERTY_IDS=cedar,harbor,juniper
# Match the backend's configured API token, if enabled there.
# STEWARD_BACKEND_TOKEN=
# Optional separate client token for this MCP listener. Not the backend token.
# STEWARD_MCP_TOKEN=
