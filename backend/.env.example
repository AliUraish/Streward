# The local app works without external accounts. Never commit real credentials.
# Values are read after stripping inline "# comments"; an empty value means unset (never "").
STEWARD_DATA_DIR=./data
BACKEND_PORT=8001
STEWARD_MODEL_PROVIDER=local
# For an OpenAI-compatible model gateway:
# STEWARD_MODEL_PROVIDER=openai
# STEWARD_MODEL_BASE_URL=https://api.openai.com/v1
# STEWARD_MODEL_API_KEY=
# STEWARD_MODEL_NAME=
# Optional Claude CLI subscription: requires `claude auth login` beforehand.
# STEWARD_MODEL_PROVIDER=claude_cli
# Optional separately authenticated eve process:
# STEWARD_MODEL_PROVIDER=eve
# STEWARD_EVE_URL=http://127.0.0.1:2000
# STEWARD_EVE_READY=true
# Let the configured model rephrase the agents' templated A2A text parts (templates stay in the data part).
# STEWARD_AGENT_PHRASING=false
# Optional service adapters. Status remains not_configured until configured.
# SUPERMEMORY_API_KEY=
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# INSFORGE_BASE_URL=https://your-project.insforge.app
# INSFORGE_ANON_KEY=
# STEWARD_PUBLIC_APP_URL=http://localhost:3000
# External messages and payments remain disabled in this local build.
STEWARD_ALLOW_EXTERNAL_MESSAGES=false
# STEWARD_ALLOW_IDENTITY_PROVISION=false
# Canonical application settings use STEWARD_*. Existing PHY_* aliases remain supported.

# ---- Inkbox identities: the four agents (REALITY-CONTRACT-2.md) ----
# INKBOX_API_KEY=
# INKBOX_BASE_URL=https://inkbox.ai
# Atlas (level 2) and Runner (level 4) have one identity each; every site's Warden (level 3) has its own.
# The Warden identity is also the site identity used for SMS/email/voice dispatch and inbound routing.
# INKBOX_IDENTITY_ATLAS=
# INKBOX_IDENTITY_RUNNER=
# INKBOX_IDENTITY_WARDEN_HARBOR_WORKS=
# INKBOX_IDENTITY_WARDEN_MYER_PLANT=
# INKBOX_IDENTITY_WARDEN_BRISTOL_PUMPS=
# Shared fallback used by any Warden without its own handle (legacy INKBOX_IDENTITY_<SITE> is also read).
# INKBOX_IDENTITY=
# Outbound A2A sends need the *sending* identity's claimed, agent-scoped API key (identity.a2a_client() refuses the
# org key). Replies, skills and inbox recovery fall back to INKBOX_API_KEY. Without a key the bus records the task
# with transport "local" and a providerError; nothing is reported as sent.
# INKBOX_AGENT_KEY_ATLAS=
# INKBOX_AGENT_KEY_RUNNER=
# INKBOX_AGENT_KEY_WARDEN_HARBOR_WORKS=
# INKBOX_AGENT_KEY_WARDEN_MYER_PLANT=
# INKBOX_AGENT_KEY_WARDEN_BRISTOL_PUMPS=
# Contract 4/5 (current) names; the WARDEN/ATLAS/RUNNER names above are retired and never read:
# INKBOX_IDENTITY_DIRECTOR=                INKBOX_AGENT_KEY_DIRECTOR=
# INKBOX_IDENTITY_<SITE>_<ROLE>=           INKBOX_AGENT_KEY_<SITE>_<ROLE>=
#   <SITE>: MYER, BRISTOL, TOMIOKA (tomioka-mill, contract 5); <ROLE>: MANAGER, ENGINEER, COMPLIANCE, TECHNICIAN
#   e.g. INKBOX_IDENTITY_TOMIOKA_ENGINEER=steward-tomioka-engineer, INKBOX_AGENT_KEY_TOMIOKA_ENGINEER=
# INKBOX_IDENTITY_DISPATCH=                the Steward Dispatch Line (the one phone number every technician uses)
# Optional explicit Agent Card URL per target handle (default: the sender's own card URL with the handle swapped).
# INKBOX_A2A_CARD_URL_<HANDLE_UPPER_WITH_UNDERSCORES>=
# Phone numbers are a separate quota: if only one number exists, INKBOX_PHONE_IDENTITY names the handle that
# owns it and SMS, iMessage and voice for every site go through that identity (task cards name the site).
# INKBOX_PHONE_IDENTITY=
# Contacts for dispatch and escalation. A phone must match ^\+?[0-9]{7,15}$ and an email must be a valid address;
# every recipient must also be in INKBOX_ALLOWED_RECIPIENTS and STEWARD_ALLOW_EXTERNAL_MESSAGES must be true,
# otherwise the dispatch channel is `local` and the dispatch note says which condition failed.
# INKBOX_CONTRACTOR_PHONE=+15550000000
# INKBOX_CONTRACTOR_EMAIL=contractor@example.com
# INKBOX_OWNER_PHONE=+15550000001
# INKBOX_OWNER_EMAIL=owner@example.com
# Owner compliance alerts (REALITY-CONTRACT-7.md §2): a walkthrough's bad compliance label emails the owner (from the site
# Compliance Officer's identity) and calls them (dispatch line) only when Inkbox is configured, STEWARD_ALLOW_EXTERNAL_MESSAGES
# and STEWARD_ALLOW_OWNER_ALERTS are true, the address/number is in INKBOX_ALLOWED_RECIPIENTS, the walkthrough was started by
# hand (autoplayed ones also need STEWARD_SCENARIO_AUTOPLAY_LIVE=true), under the daily cap and not a repeat for the same
# obligation within 24 h. Otherwise the alert records dry_run (or capped) with the full email and call brief.
# STEWARD_ALLOW_OWNER_ALERTS=false
# STEWARD_OWNER_ALERTS_PER_DAY=3
# STEWARD_ALERT_STEP_SECONDS=4      pause between alert steps (workers on)
# STEWARD_PATROL_PACE_SECONDS=8     pause per walkthrough stop (workers on)
# Continuous walks (backend/src/walks.py): each site's Engineer walks on its own (workers on), 20 s between walks; the
# scenario autoplayer no longer walks sites. Claude looks at every stop's frame with the asset's records (records decide a bad
# verdict; the frame adds the observation and the mark point). Answers are reused per asset while its state holds and for
# the TTL; past a daily cap (UTC day), without ANTHROPIC_API_KEY or with STEWARD_WALK_CLAUDE=false the rules label the stop.
# STEWARD_CONTINUOUS_WALKS=true
# STEWARD_WALK_GAP_SECONDS=20
# STEWARD_WALK_START_DELAY_SECONDS=20
# STEWARD_WALK_REPORT_MINUTES=60    a continuous walk messages the Site Manager on new findings or alerts, else hourly
# STEWARD_WALK_CLAUDE=true
# STEWARD_WALK_MODEL=claude-opus-5-5
# STEWARD_WALK_CLAUDE_MAX_TOKENS=2000
# STEWARD_WALK_CLAUDE_TTL_MINUTES=30
# STEWARD_WALK_CLAUDE_MAX_CALLS_PER_DAY=300
# STEWARD_WALK_CLAUDE_BUDGET_USD_PER_DAY=10
# Agent-to-agent messages over Inkbox (STEWARD_A2A_TRANSPORT=inkbox) only connect Steward's own identities, so they do not
# pause autoplay or the planner; the bus caps them per rolling hour (over the cap, and for machine chatter, they stay local).
# STEWARD_A2A_INKBOX_MAX_PER_HOUR=120
# INKBOX_ALLOWED_RECIPIENTS=+15550000000,contractor@example.com
# Inbound: Inkbox delivers text.received / message.received / imessage.received / call.ended and the A2A events
# a2a.task.created / a2a.task.message / a2a.task.canceled / a2a.sent_task.updated to
# {STEWARD_PUBLIC_BASE_URL}/api/inbound/inkbox. The endpoint requires X-Steward-Inbound-Secret (or the
# subscription's bearer auth_token) to equal STEWARD_INBOUND_SECRET; set INKBOX_WEBHOOK_SIGNING_KEY to also
# verify X-Inkbox-Signature. Create the subscription with `backend/scripts/inkbox_subscribe.py harbor-works`.
# STEWARD_INBOUND_SECRET=
# STEWARD_PUBLIC_BASE_URL=https://your-tunnel.example
# INKBOX_WEBHOOK_SIGNING_KEY=
# Work-item deadline used by the escalation scheduler (seconds, default 7200).
# STEWARD_WORK_DEADLINE_SECONDS=7200

# ---- Simulation (REALITY-CONTRACT-2.md) ----
# Background thread (only with workers): sensor readings every 20 s on every site, one plausible event every
# 2 min on the non-demo sites. Every simulated record carries simulated: true; harbor-works gets readings only.
STEWARD_SIMULATION=true

# ---- Evals ----
# POST /api/evals/run spawns agent-runtime/node_modules/node/bin/node evals/run.mjs against these loopback URLs.
# STEWARD_MCP_URL=http://127.0.0.1:8002/mcp
# STEWARD_SELF_URL=http://127.0.0.1:8001
# Override the runner command (tests use it); it still receives --json --mcp --backend --workflow.
# STEWARD_EVAL_RUNNER=

# ---- Supabase mirror (optional). SQLite remains the source of truth; see backend/SUPABASE-COLUMNS.md. ----
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=
