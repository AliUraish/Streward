{
  "name": "steward-factory-myer-plant-overpressure",
  "suite": "factory-workflow",
  "description": "REALITY-CONTRACT-3.md §10 factory workflow: overview → issue → focus_view → wait_for → resolution, on the my-overpressure scenario (PG-601 at 4.1 bar on a 3.5 bar circuit). The operator starts the scenario, holds wait_for (zero tokens, progress every 15 s) until it moves, finds the issue, points the dashboard camera at it, holds wait_for again until Atlas's board meeting resolves, then reads the resolution, the owner and the scene.",
  "siteId": "myer-plant",
  "notes": [
    "wait_for steps use until + carry: a still_waiting result is re-called with the same waitId (still one held call per window, no polling). timeoutMs bounds the whole step.",
    "The suite assumes the backend opens the PG-601 issue with scenarioId my-overpressure and that Atlas's board meeting on it names the duty engineer; the fixture (mcp-runtime/tests/fake-reality.ts) does exactly that.",
    "A backend that runs a scenario faster than the MCP can open the second wait would fire board.resolved before the wait exists; the backend's wait semantics (only future changes) decide that, so a miss shows as a timeout here."
  ],
  "steps": [
    { "id": "overview", "kind": "tool", "tool": "get_overview", "args": {},
      "expect": { "sites[siteId=myer-plant].name": { "$exists": true }, "sites[siteId=bristol-pumps].name": { "$exists": true }, "agents": { "$jsonContains": "\"agentId\":\"atlas\"" }, "tokensEstimate": { "$lte": 600 } } },
    { "id": "scenarios_listed", "kind": "tool", "tool": "list_scenarios", "args": {},
      "expect": { "scenarios[id=my-overpressure].siteId": "myer-plant", "scenarios": { "$jsonContains": "\"id\":\"br-sump\"" } } },
    { "id": "start_overpressure", "kind": "tool", "tool": "start_scenario", "args": { "scenarioId": "my-overpressure" },
      "expect": { "scenarioId": "my-overpressure", "state": { "$in": ["running", "completed"] } }, "capture": { "runId": "id" } },
    { "id": "wait_scenario_moves", "kind": "tool", "tool": "wait_for",
      "args": { "event": "scenario.step", "filter": { "scenarioId": "my-overpressure" }, "timeoutSeconds": 50 },
      "until": { "status": "fired" }, "carry": { "waitId": "waitId" }, "intervalMs": 0, "timeoutMs": 120000,
      "expect": { "status": "fired", "tokensWhileWaiting": 0, "event.scenarioId": "my-overpressure", "waitId": { "$exists": true } } },
    { "id": "issue_listed", "kind": "tool", "tool": "list_issues", "args": { "siteId": "myer-plant", "status": "open" },
      "until": { "issues[scenarioId=my-overpressure].id": { "$exists": true } }, "intervalMs": 1000, "timeoutMs": 30000,
      "expect": { "issues[scenarioId=my-overpressure].assetTag": "PG-601", "issues[scenarioId=my-overpressure].severity": "high" },
      "capture": { "issueId": "issues[scenarioId=my-overpressure].id" } },
    { "id": "issue_detail", "kind": "tool", "tool": "get_issue", "args": { "issueId": "${issueId}" },
      "expect": { "id": "${issueId}", "siteId": "myer-plant", "assetTag": "PG-601", "severity": "high", "summary": { "$matches": "/4\\.1/" } } },
    { "id": "focus_dashboard", "kind": "tool", "tool": "focus_view", "args": { "siteId": "myer-plant", "issueId": "${issueId}", "action": "highlight" },
      "expect": { "commandId": { "$exists": true }, "siteId": "myer-plant", "action": "highlight" } },
    { "id": "wait_board_resolved", "kind": "tool", "tool": "wait_for",
      "args": { "event": "board.resolved", "siteId": "myer-plant", "filter": { "scenarioId": "my-overpressure" }, "timeoutSeconds": 50 },
      "until": { "status": "fired" }, "carry": { "waitId": "waitId" }, "intervalMs": 0, "timeoutMs": 180000,
      "expect": { "status": "fired", "tokensWhileWaiting": 0, "event.type": "board.resolved" } },
    { "id": "board_resolution", "kind": "tool", "tool": "get_board_meeting", "args": { "issueId": "${issueId}" },
      "expect": { "resolution": { "$exists": true }, "state": "resolved", "participants": { "$contains": "atlas" }, "contact.role": { "$matches": "/duty engineer/i" }, "contact.phone": { "$exists": false } } },
    { "id": "owner", "kind": "tool", "tool": "who_is_responsible", "args": { "siteId": "myer-plant", "issueKind": "out_of_range" },
      "expect": { "crewMember.role": { "$matches": "/duty engineer/i" }, "crewMember.hasPhone": { "$in": [true, false] } } },
    { "id": "issue_after_resolution", "kind": "tool", "tool": "get_issue", "args": { "issueId": "${issueId}" },
      "expect": { "status": { "$in": ["assigned", "acknowledged", "resolved"] } } },
    { "id": "scene_shows_issue", "kind": "tool", "tool": "get_scene", "args": { "siteId": "myer-plant" },
      "expect": { "assets[assetTag=PG-601].severity": "high", "assets[assetTag=PG-601].pin": { "$exists": true }, "sogUrl": "https://d28zzqy0iyovbz.cloudfront.net/66b655d3/v1/meta.json", "credit.url": "https://superspl.at/scene/66b655d3" } },
    { "id": "show_factory", "kind": "tool", "tool": "show_factory", "args": { "siteId": "myer-plant" },
      "expect": { "summary": { "$matches": "/PG-601/" }, "widget.resourceUri": "ui://views/steward-factory.html", "counts.openIssues": { "$gte": 1 } } }
  ]
}
