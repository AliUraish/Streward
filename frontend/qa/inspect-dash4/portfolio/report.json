  {
   "level": "WARN",
   "id": "card-rows",
   "width": 1440,
   "message": "5 rows of identical boxed cards.",
   "fix": "Vary the composition; not every section is a card grid.",
   "alsoAt": [
    390
   ]
  },
  {
   "level": "FAIL",
   "id": "few-pictures",
   "width": 1440,
   "message": "Only 2 picture(s) on the page (2 photographs, footage or raster images, 0 interface fragments). Drawings in SVG do not count.",
   "fix": "Find real pictures of the subject's world with scripts/assets.mjs (photographs, archival images, maps, engravings, footage), download them to assets/ and give them room: a hero picture, one per section that has a subject, a full-width band. At least four, usually six to twelve."
  },
  {
   "level": "WARN",
   "id": "no-footage",
   "width": 1440,
   "message": "No video anywhere on the page.",
   "fix": "Look for one honest clip with scripts/assets.mjs --video (the place, the material, the process) and use it as a muted loop with a poster frame. Defend its absence only if no clip fits the subject."
  },
  {
   "level": "WARN",
   "id": "blend-text",
   "width": 1440,
   "message": "22 text element(s) use mix-blend-mode difference or exclusion.",
   "fix": "Over anything but black, white or grey, blended text takes random hues (blue on orange, lilac on green) that jurors read as a glitch. Use a solid ink chosen for the ground, or keep the blended text over neutral grounds only.",
   "alsoAt": [
    390
   ]
  },
  {
   "level": "FAIL",
   "id": "focal-point",
   "width": 1440,
   "message": "The first screen has no dominant element: the largest type is 44px (3.1vw) and no single picture holds a third of the viewport.",
   "fix": "Make one thing lead: the headline at display size, or one large picture. A grid of many small pictures is not one thing; in blind tests jurors marked a first screen without a headline down every time. On the strongest studied sites the largest type has a median of 8.4vw."
  },
  {
   "level": "WARN",
   "id": "first-action",
   "width": 390,
   "message": "No visible button in the first phone screen.",
   "fix": "On a phone the first screen still holds the headline, the supporting sentence and the action; move navigation into one row or a menu so it does not push them down."
  }
